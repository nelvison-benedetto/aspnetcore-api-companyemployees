
//appsettings.json configs di base comune a tutti gli ambienti (Development/Staging/Production)
//aspnetcore carica prima appsettings.json, poi sovrascrive i valori (w quelli in app.settings.Deveelopment/Staging/Production.json) in base a in che ambiente ti trovi.

//JWT + OAuth2/OIDC è lo standard moderno today!!
{
  "Logging": {
    "LogLevel": {
      "Default": "Information", //lv di log predefinito
      "Microsoft.AspNetCore": "Warning" //lv di log x libs aspnetcore
    }
  }, //serve x evitare di vedere troppi mex di debug da libs esterne, mentre il tuo code okok.

  "ConnectionStrings": {
    "sqlConnection": "Data Source=LEGION5\\SQLEXPRESS;Initial Catalog=CompanyEmployeesDB;Integrated Security=True;Encrypt=False;Trust Server Certificate=True"
  }, //connessione al target db su microsoft sql server.
  //Data Source → nome del server, Initial Catalog → database, Integrated Security=True → login Windows, Encrypt=False;Trust Server Certificate=True → certificato SSL per connessione. in production cambierai molto questi valori.
  //in Production abiliti https w Encypt=True

  "JwtSettings": {
    "ValidIssuer": "BusinessDev", //chi ha emesso il token (e.g.nome applicazione)
    "ValidAudience": "https://localhost:5001" //chi può usare il token (es. url del client/API)
  },
  "AllowedHosts": "*" //quali hosts possono fare richieste all’API. here tutti. in production puoi limitare e.g."mycompany.com"

}
